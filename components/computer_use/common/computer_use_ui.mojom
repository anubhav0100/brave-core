module computer_use.mojom;

// Browser-side handler for the computer-use WebUI page (chrome://computer-use).
interface PageHandler {
  // Whether an AI computer-use session is active, whether the emergency
  // stop has been triggered (and not yet resumed), and the most recently
  // captured desktop frame (as a data: URL), if any.
  GetState() => (bool active, bool emergency_stopped, string frame_data_url);

  // Triggers the emergency stop - same effect as the global hotkey
  // (Ctrl+Alt+Shift+Esc): immediately blocks all further desktop_* input
  // tool calls until Resume() is called. See brave-ai-computer-use.md,
  // Phase 2 safety architecture item 2.
  Stop();

  // Clears the emergency stop, allowing desktop_* input tools to run
  // again. Deliberately requires this explicit user action - the AI can't
  // resume itself.
  Resume();
};
