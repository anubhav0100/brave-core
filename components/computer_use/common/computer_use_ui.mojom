module computer_use.mojom;

// One completed or still-open RDP session in the user-facing history log.
// `disconnected_at` is null while the session is still open.
struct RdpHistoryEntry {
  string host;
  int32 port;
  // Milliseconds since the Unix epoch (JS Date-compatible).
  double connected_at;
  double? disconnected_at;
};

// Browser-side handler for the computer-use WebUI page (chrome://computer-use).
interface PageHandler {
  // Whether an AI computer-use session is active, whether the emergency
  // stop has been triggered (and not yet resumed), the most recently
  // captured desktop frame (as a data: URL) if any, and whether an RDP
  // session is active plus which host:port it's connected to (host empty,
  // port 0 if none).
  GetState() => (
      bool active,
      bool emergency_stopped,
      string frame_data_url,
      bool rdp_active,
      string rdp_target_host,
      int32 rdp_target_port);

  // Triggers the emergency stop - same effect as the global hotkey
  // (Ctrl+Alt+Shift+Esc): immediately blocks all further desktop_* input
  // tool calls until Resume() is called. See brave-ai-computer-use.md,
  // Phase 2 safety architecture item 2.
  Stop();

  // Clears the emergency stop, allowing desktop_* input tools to run
  // again. Deliberately requires this explicit user action - the AI can't
  // resume itself.
  Resume();

  // Manually opens an RDP session to `host`:`port`, initiated directly by
  // the user from this page (as opposed to the AI-invoked open_rdp_session
  // tool, which always re-challenges for consent). `success` is false and
  // `error` non-empty if the connection attempt failed. Windows-only -
  // fails immediately with an error on other platforms.
  ConnectRdp(string host, int32 port) => (bool success, string error);

  // Disconnects the current RDP session, if any. No-op if none is active.
  DisconnectRdp();

  // The persisted (survives restart) log of RDP sessions on this profile,
  // most recent first.
  GetRdpHistory() => (array<RdpHistoryEntry> history);

  // Whether get_desktop_screenshot's per-conversation "Security warning"
  // permission challenge is skipped for every conversation on this
  // profile, persisted across restarts. Off by default - a real reduction
  // in per-conversation consent, so it's an explicit opt-in here rather
  // than something a single in-chat "Allow" click sets on its own.
  GetAlwaysAllowDesktopScreenshot() => (bool always_allow);
  SetAlwaysAllowDesktopScreenshot(bool always_allow);

  // Registers `page` to receive OnFrameCaptured() pushes for as long as the
  // page is open - the WebUI page's live view of the RDP session (see
  // rdp_session.h; RDP's window is hidden, so this push is the only way its
  // content ever reaches the user). A later call replaces any previously
  // bound page (mirrors ComputerUseSessionState::SetRdpFrameCapturedCallback,
  // which this delegates to).
  BindPage(pending_remote<Page> page);

  // Forwards mouse/keyboard input to the active RDP session window, for the
  // WebUI page's <canvas> to call as the user interacts with it. No-ops if
  // no RDP session is active. See RdpSession::SendMouseEvent()/
  // SendKeyEvent() for the exact parameter semantics.
  SendRdpMouseEvent(int32 x, int32 y, int32 buttons, int32 wheel_delta);
  SendRdpKeyEvent(int32 virtual_key_code, bool key_down);

  // Shows (or re-hides) the RDP session's own native window as a real,
  // focusable, on-screen window - an escape hatch for precise mouse/
  // keyboard control alongside the embedded live view, since a real
  // foreground window trivially supports full input the way a captured-
  // and-forwarded canvas may not always match perfectly. The embedded
  // canvas keeps working normally either way - this doesn't affect
  // capture, only whether the underlying window is also visible.
  SetRdpShownAsWindow(bool show);

  // Opens a second chrome://computer-use tab in the current browser
  // window, so the live RDP view can sit alongside whatever else is
  // already open. Routed through the browser process rather than a plain
  // window.open() call on the WebUI page's own URL, which does not
  // correctly reinitialize this page's Mojo bindings for the new tab.
  OpenNewComputerUseTab();
};

// Pushed from the browser to the computer-use WebUI page.
interface Page {
  // A freshly captured frame of the active RDP session window, as a
  // data: URL - pushed on a repeating timer (see ComputerUseSessionState's
  // rdp_capture_timer_) for as long as RDP stays connected.
  OnFrameCaptured(string frame_data_url);

  // Fires whenever RDP connects or disconnects, for any reason - including
  // ones the page didn't itself initiate, like the AI's open_rdp_session
  // tool connecting, the remote server dropping the connection, or the
  // remote user closing the session from inside it. Lets the page keep its
  // canvas/status in sync without polling GetState().
  OnRdpStateChanged(bool rdp_active, string rdp_target_host,
                    int32 rdp_target_port);
};
