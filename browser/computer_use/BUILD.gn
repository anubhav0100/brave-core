source_set("computer_use") {
  sources = [
    "computer_use_session_state.cc",
    "computer_use_session_state.h",
    "computer_use_session_state_factory.cc",
    "computer_use_session_state_factory.h",
    "desktop_capture_session.cc",
    "desktop_capture_session.h",
  ]

  deps = [
    "//base",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//skia",
    "//third_party/libyuv",
    "//third_party/webrtc_overrides:webrtc_component",
    "//ui/gfx",
    "//ui/gfx/codec",
  ]

  # Phase 2 (local input injection) and Phase 3 (RDP) - OS-level
  # SendInput()/RegisterHotKey()/ActiveX-hosting APIs are Windows-only for
  # now, matching this feature's grounding research (see
  # brave-ai-computer-use.md): no equivalent precedent was found for other
  # platforms yet.
  if (is_win) {
    sources += [
      "action_risk_classifier.cc",
      "action_risk_classifier.h",
      "global_stop_hotkey.cc",
      "global_stop_hotkey.h",
      "input_injector.cc",
      "input_injector.h",
      "rdp_session.cc",
      "rdp_session.h",
      "win/com_imported_mstscax.h",
    ]
    deps += [
      "//third_party/wtl",
      "//ui/base",
    ]
    if (is_clang) {
      # The MIDL-generated COM interface header (win/com_imported_mstscax.h)
      # produces nonstandard C++ enums - same flag
      # //remoting/host/win:rdp_window uses for the identical file.
      cflags = [ "-Wno-microsoft-enum-forward-reference" ]
    }
  }
}

if (is_win) {
  source_set("unit_tests") {
    testonly = true
    sources = [ "action_risk_classifier_unittest.cc" ]
    deps = [
      ":computer_use",
      "//base",
      "//components/prefs:test_support",
      "//testing/gmock",
      "//testing/gtest",
    ]
  }
}
